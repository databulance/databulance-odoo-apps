<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_generate_slots" model="ir.cron">
        <field name="name">BookingLance: Generate Slots</field>
        <field name="state">code</field>
        <field name="code">
env['booking_lance.slot']._cron_generate_all_slots()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="cron_send_reminders" model="ir.cron">
        <field name="name">BookingLance: Send Reminders</field>
        <field name="state">code</field>
        <field name="code">
env['booking_lance.booking']._cron_send_reminders()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>

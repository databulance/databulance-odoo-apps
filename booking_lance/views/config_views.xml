<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bl_config_form" model="ir.ui.view">
        <field name="name">booking_lance.config.form</field>
        <field name="model">booking_lance.config</field>
        <field name="arch" type="xml">
            <form string="BookingLance Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="website_id"
                                   placeholder="Select Website"/>
                        </h1>
                    </div>
                    <group string="Branding">
                        <group>
                            <field name="brand_name"/>
                            <field name="brand_color"
                                   widget="color"/>
                        </group>
                        <group>
                            <field name="brand_logo"
                                   widget="image"
                                   class="oe_avatar"/>
                        </group>
                    </group>
                    <group string="Booking Rules">
                        <group>
                            <field name="slot_generation_days"/>
                            <field name="cancellation_hours_limit"/>
                            <field name="reschedule_hours_limit"/>
                        </group>
                        <group>
                            <field name="allow_waitlist"/>
                            <field name="allow_recurring"/>
                            <field name="notify_admin_email"/>
                        </group>
                    </group>
                    <group string="Confirmation Message">
                        <field name="confirmation_message"
                               nolabel="1"
                               widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bl_config_list" model="ir.ui.view">
        <field name="name">booking_lance.config.list</field>
        <field name="model">booking_lance.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="website_id"/>
                <field name="brand_name"/>
                <field name="slot_generation_days"/>
                <field name="cancellation_hours_limit"/>
                <field name="allow_waitlist"/>
                <field name="allow_recurring"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_bl_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">booking_lance.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

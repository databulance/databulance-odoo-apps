<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bl_slot_list" model="ir.ui.view">
        <field name="name">booking_lance.slot.list</field>
        <field name="model">booking_lance.slot</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'blocked'"
                  decoration-success="state == 'available'"
                  decoration-danger="state == 'booked'">
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="service_id"/>
                <field name="staff_id"/>
                <field name="booked_count"/>
                <field name="is_available"/>
                <field name="is_manual"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-danger="state == 'booked'"
                       decoration-warning="state == 'waitlist'"
                       decoration-muted="state == 'blocked'"/>
                <button name="action_block"
                        string="Block"
                        type="object"
                        icon="fa-ban"
                        invisible="state != 'available'"/>
                <button name="action_unblock"
                        string="Unblock"
                        type="object"
                        icon="fa-check"
                        invisible="state != 'blocked'"/>
            </list>
        </field>
    </record>

    <record id="view_bl_slot_form" model="ir.ui.view">
        <field name="name">booking_lance.slot.form</field>
        <field name="model">booking_lance.slot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_block"
                            string="Block Slot"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'available'"/>
                    <button name="action_unblock"
                            string="Unblock Slot"
                            type="object"
                            class="btn-success"
                            invisible="state != 'blocked'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="service_id"/>
                            <field name="staff_id"/>
                            <field name="website_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="booked_count"/>
                            <field name="is_available"/>
                            <field name="is_manual"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Bookings">
                        <field name="booking_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bl_slot_calendar" model="ir.ui.view">
        <field name="name">booking_lance.slot.calendar</field>
        <field name="model">booking_lance.slot</field>
        <field name="arch" type="xml">
            <calendar string="Time Slots"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="staff_id"
                      mode="week">
                <field name="service_id"/>
                <field name="staff_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_bl_slots" model="ir.actions.act_window">
        <field name="name">Time Slots</field>
        <field name="res_model">booking_lance.slot</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>

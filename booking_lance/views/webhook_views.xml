<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bl_webhook_list" model="ir.ui.view">
        <field name="name">booking_lance.webhook.list</field>
        <field name="model">booking_lance.webhook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="url"/>
                <field name="event"/>
                <field name="last_triggered"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bl_webhook_form" model="ir.ui.view">
        <field name="name">booking_lance.webhook.form</field>
        <field name="model">booking_lance.webhook</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="event"/>
                        </group>
                        <group>
                            <field name="secret_key"
                                   password="True"/>
                            <field name="active"/>
                            <field name="last_triggered"
                                   readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bl_webhooks" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">booking_lance.webhook</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_edu_level_list" model="ir.ui.view">
    <field name="name">edu.level.list</field><field name="model">edu.level</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="code"/><field name="name"/>
        <field name="color" widget="color"/><field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_edu_level_form" model="ir.ui.view">
    <field name="name">edu.level.form</field><field name="model">edu.level</field>
    <field name="arch" type="xml">
      <form><sheet><div class="oe_title"><h1><field name="name"/></h1></div>
        <group><group>
          <field name="code" placeholder="e.g. A1, Level 1, Beginner (optional)"/>
          <field name="sequence"/><field name="active"/>
        </group><group><field name="color" widget="color"/></group></group>
        <field name="description"/>
      </sheet></form>
    </field>
  </record>
  <record id="action_edu_level" model="ir.actions.act_window">
    <field name="name">Levels</field><field name="res_model">edu.level</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

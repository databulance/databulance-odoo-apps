<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_edu_subject_list" model="ir.ui.view">
    <field name="name">edu.subject.list</field><field name="model">edu.subject</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/><field name="icon"/><field name="color" widget="color"/>
        <field name="curriculum_count"/><field name="student_count"/><field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_edu_subject_form" model="ir.ui.view">
    <field name="name">edu.subject.form</field><field name="model">edu.subject</field>
    <field name="arch" type="xml">
      <form><sheet><div class="oe_title"><h1><field name="name"/></h1></div>
        <group><group><field name="icon"/><field name="color" widget="color"/></group>
        <group><field name="active"/></group></group>
        <field name="description"/>
      </sheet></form>
    </field>
  </record>
  <record id="action_edu_subject" model="ir.actions.act_window">
    <field name="name">Subjects</field><field name="res_model">edu.subject</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

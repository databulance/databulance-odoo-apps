<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_edu_lead_kanban" model="ir.ui.view">
    <field name="name">edu.lead.kanban</field><field name="model">edu.lead</field>
    <field name="arch" type="xml">
      <kanban default_group_by="stage_id" group_expand="True">
        <field name="partner_name"/><field name="email"/><field name="phone"/>
        <field name="subject_id"/><field name="level_id"/><field name="stage_id"/>
        <field name="color"/><field name="user_id"/>
        <templates><t t-name="card" color="color">
          <field name="partner_name" class="fw-bold"/>
          <field name="subject_id"/><field name="level_id"/>
          <div class="text-muted small"><field name="phone"/></div>
          <field name="user_id" widget="many2one_avatar_user"/>
        </t></templates>
      </kanban>
    </field>
  </record>
  <record id="view_edu_lead_list" model="ir.ui.view">
    <field name="name">edu.lead.list</field><field name="model">edu.lead</field>
    <field name="arch" type="xml">
      <list><field name="partner_name"/><field name="email"/><field name="phone"/>
        <field name="stage_id"/><field name="subject_id"/><field name="level_id"/>
        <field name="source"/><field name="user_id"/><field name="create_date"/>
      </list>
    </field>
  </record>
  <record id="view_edu_lead_form" model="ir.ui.view">
    <field name="name">edu.lead.form</field><field name="model">edu.lead</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_convert_to_student" string="Convert to Student"
                  type="object" class="btn-primary"
                  invisible="converted_student_id != False"/>
          <field name="stage_id" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="partner_name"/></h1></div>
          <group><group string="Contact">
            <field name="email"/><field name="phone"/>
            <field name="source"/><field name="user_id"/>
          </group><group string="Interest">
            <field name="subject_id"/><field name="level_id"/>
            <field name="trial_session_id"/><field name="priority" widget="priority"/>
          </group></group>
          <group string="Conversion" invisible="converted_student_id == False">
            <field name="converted_student_id" readonly="1"/>
            <field name="converted_at" readonly="1"/>
          </group>
          <field name="notes" widget="html"/>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="action_edu_lead" model="ir.actions.act_window">
    <field name="name">Leads</field><field name="res_model">edu.lead</field>
    <field name="view_mode">kanban,list,form</field>
  </record>
  <record id="action_edu_pipeline_stage" model="ir.actions.act_window">
    <field name="name">Pipeline Stages</field><field name="res_model">edu.pipeline.stage</field>
    <field name="view_mode">list</field>
  </record>
  <record id="action_edu_student" model="ir.actions.act_window">
    <field name="name">Students</field><field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_is_student','=',True)]</field>
    <field name="context">{'default_x_is_student': True}</field>
  </record>
  <record id="action_edu_teacher" model="ir.actions.act_window">
    <field name="name">Teachers</field><field name="res_model">hr.employee</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_is_teacher','=',True)]</field>
    <field name="context">{'default_x_is_teacher': True}</field>
  </record>
  <record id="action_edu_curriculum" model="ir.actions.act_window">
    <field name="name">Curricula</field><field name="res_model">edu.curriculum</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_edu_group" model="ir.actions.act_window">
    <field name="name">Groups</field><field name="res_model">edu.group</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_edu_session" model="ir.actions.act_window">
    <field name="name">Sessions</field><field name="res_model">edu.session</field>
    <field name="view_mode">list,form,calendar</field>
  </record>
  <record id="action_edu_homework" model="ir.actions.act_window">
    <field name="name">Homework</field><field name="res_model">edu.homework</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_edu_subscription_type" model="ir.actions.act_window">
    <field name="name">Subscription Types</field><field name="res_model">edu.subscription.type</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_edu_subscription" model="ir.actions.act_window">
    <field name="name">Subscriptions</field><field name="res_model">edu.subscription</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_edu_resource" model="ir.actions.act_window">
    <field name="name">Resources</field><field name="res_model">edu.resource</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_edu_payout" model="ir.actions.act_window">
    <field name="name">Payouts</field><field name="res_model">edu.payout</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_edu_config_settings" model="ir.actions.act_window">
    <field name="name">EduLance Settings</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field><field name="target">current</field>
    <field name="context">{'module': 'edu_lance'}</field>
  </record>
  <record id="action_edu_migration_wizard" model="ir.actions.act_window">
    <field name="name">Import from EduOps</field>
    <field name="res_model">edu.migration.wizard</field>
    <field name="view_mode">form</field><field name="target">new</field>
  </record>
</odoo>

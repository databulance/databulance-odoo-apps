<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_yookassa_completion_receipts"
            model="ir.cron">
        <field name="name">
            YooKassa Pro: Send 54-ФЗ completion receipts
        </field>
        <field name="model_id"
               ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">
env['payment.yookassa.pro.cron'].cron_send_overdue_completion_receipts()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
